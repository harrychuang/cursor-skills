import { useMemo, useState } from "react";

import "./__FEATURE_KEBAB__.css";
import {
  __FEATURE_CAMEL__Routes,
  type __FEATURE_PASCAL__RouteContent,
} from "./__FEATURE_CAMEL__Data";
import {
  get__FEATURE_PASCAL__Route,
  __FEATURE_CAMEL__RouteIds,
  type __FEATURE_PASCAL__RouteId,
} from "./__FEATURE_CAMEL__Flow";

export type __FEATURE_PASCAL__Props = {
  initialRouteId?: __FEATURE_PASCAL__RouteId;
  isFlowPreview?: boolean;
};

function is__FEATURE_PASCAL__RouteId(
  value: string | null,
): value is __FEATURE_PASCAL__RouteId {
  return __FEATURE_CAMEL__RouteIds.includes(value as __FEATURE_PASCAL__RouteId);
}

function getRouteFromLocation() {
  if (typeof window === "undefined") {
    return undefined;
  }

  const routeId = new URLSearchParams(window.location.search).get("prototypeRoute");
  return is__FEATURE_PASCAL__RouteId(routeId) ? routeId : undefined;
}

function getFlowPreviewFromLocation() {
  if (typeof window === "undefined") {
    return false;
  }

  return new URLSearchParams(window.location.search).get("prototypeFlowPreview") === "true";
}

function RoutePanel({
  route,
}: {
  route: __FEATURE_PASCAL__RouteContent;
}) {
  // Replace this placeholder markup with the design-system components mapped
  // per route in docs/UI_SPEC.md "Component Map". Local markup is allowed only
  // for regions listed under "Component Gaps".
  const state = route.state ?? "default";

  return (
    <section className="__FEATURE_CSS_CLASS____panel" aria-labelledby={`${route.id}-title`}>
      <p className="__FEATURE_CSS_CLASS____eyebrow">{route.id}</p>
      <h2 id={`${route.id}-title`}>{route.title}</h2>
      {state === "loading" ? (
        <div
          className="__FEATURE_CSS_CLASS____state __FEATURE_CSS_CLASS____state--loading"
          role="status"
          aria-label={`Loading ${route.title}`}
        >
          <span className="__FEATURE_CSS_CLASS____skeleton" />
          <span className="__FEATURE_CSS_CLASS____skeleton" />
        </div>
      ) : state === "empty" ? (
        <div className="__FEATURE_CSS_CLASS____state __FEATURE_CSS_CLASS____state--empty">
          <p>{route.description}</p>
        </div>
      ) : state === "error" ? (
        <div
          className="__FEATURE_CSS_CLASS____state __FEATURE_CSS_CLASS____state--error"
          role="alert"
        >
          <p>{route.description}</p>
          <button type="button">Retry</button>
        </div>
      ) : (
        <p>{route.description}</p>
      )}
    </section>
  );
}

export function __FEATURE_PASCAL__({
  initialRouteId = "__ENTRY_ROUTE_ID__",
  isFlowPreview = false,
}: __FEATURE_PASCAL__Props) {
  const previewRoute = getRouteFromLocation();
  const [routeId, setRouteId] = useState<__FEATURE_PASCAL__RouteId>(
    previewRoute ?? initialRouteId,
  );
  const visibleRoute = previewRoute ?? routeId;
  const activeRoute = get__FEATURE_PASCAL__Route(visibleRoute);
  const routeContent = useMemo(
    () =>
      __FEATURE_CAMEL__Routes.find((route) => route.id === activeRoute.id) ??
      __FEATURE_CAMEL__Routes[0],
    [activeRoute.id],
  );
  const isEmbeddedFlowPreview = isFlowPreview || getFlowPreviewFromLocation();

  const goTo = (nextRoute: __FEATURE_PASCAL__RouteId) => {
    if (!previewRoute) {
      setRouteId(nextRoute);
    }
  };

  return (
    <main
      className={[
        "__FEATURE_CSS_CLASS__",
        isEmbeddedFlowPreview ? "__FEATURE_CSS_CLASS__--flow-preview" : "",
      ]
        .filter(Boolean)
        .join(" ")}
      data-prototype-root="true"
      data-route={visibleRoute}
      aria-label="__FEATURE_TITLE__"
      role="region"
    >
      <section
        className="__FEATURE_CSS_CLASS____shell"
        data-prototype-route-preview="true"
      >
        <header className="__FEATURE_CSS_CLASS____header">
          <div>
            <p className="__FEATURE_CSS_CLASS____eyebrow">Prototype</p>
            <h1>{activeRoute.title}</h1>
          </div>
        </header>

        <nav className="__FEATURE_CSS_CLASS____nav" aria-label="Prototype routes">
          {__FEATURE_CAMEL__RouteIds.map((id) => {
            const route = get__FEATURE_PASCAL__Route(id);
            return (
              <button
                key={id}
                type="button"
                aria-pressed={visibleRoute === id}
                onClick={() => goTo(id)}
              >
                {route.title}
              </button>
            );
          })}
        </nav>

        <RoutePanel route={routeContent} />
      </section>
    </main>
  );
}
