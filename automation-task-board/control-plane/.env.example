# 本機開發：先執行 npm run dev-db（embedded PostgreSQL，資料在 .devdb/）
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/taskboard"

# Google OAuth（task 2.1 之後需要）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=
# 允許清單：逗號分隔的 email
# MEMBER_ALLOWLIST=designer-a@example.com,designer-b@example.com

# log 保留天數（預設 30）
# LOG_RETENTION_DAYS=30

# 本機 UI 預覽（僅 development 生效；production 完全忽略）：
# 設定後跳過 Google 登入牆，以此 email 充當已登入成員
# DEV_PREVIEW_MEMBER_EMAIL=dev@example.com
