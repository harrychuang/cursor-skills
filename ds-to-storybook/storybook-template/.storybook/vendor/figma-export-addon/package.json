{
  "name": "@harrychuang/storybook-addon-figma-export",
  "version": "0.9.0",
  "description": "Export Storybook stories to Figma import payloads with configurable CSS token layers",
  "type": "module",
  "license": "MIT",
  "author": "Harry Chuang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrychuang/storybook-addons.git",
    "directory": "packages/figma-export"
  },
  "bugs": {
    "url": "https://github.com/harrychuang/storybook-addons/issues"
  },
  "homepage": "https://github.com/harrychuang/storybook-addons/tree/main/packages/figma-export#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/manager.js",
    "./dist/figma-code-exporter.css",
    "./dist/review.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "default": "./dist/manager.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "default": "./dist/review.js"
    },
    "./review-server": {
      "types": "./dist/review-server.d.ts",
      "default": "./dist/review-server.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "default": "./dist/source.js"
    },
    "./visual-comment-store": {
      "types": "./dist/visual-comment-store.d.ts",
      "default": "./dist/visual-comment-store.js"
    },
    "./visual-comment-report": {
      "types": "./dist/visual-comment-report.d.ts",
      "default": "./dist/visual-comment-report.js"
    },
    "./styles.css": "./dist/figma-code-exporter.css",
    "./review.css": "./dist/review.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test:renderer-fixtures": "node test/run-renderer-fixture-builds.mjs",
    "test:renderer-parity": "node test/run-renderer-parity.mjs",
    "test:renderer-parity:probe": "node test/run-renderer-parity.mjs --probe-vue-gap",
    "test:renderer-neutral": "npm run build && node test/run-renderer-neutral-build-test.mjs && node test/run-visual-comment-fixture.mjs",
    "test:package": "npm run build && node test/run-package-contract-test.mjs",
    "test:review-controller": "npm run build && node test/run-review-controller-test.mjs",
    "test:plugin-code": "npm run build && node test/run-plugin-code-test.mjs",
    "test:visual-comments": "npm run build && node test/run-visual-comment-store-test.mjs && node test/run-visual-comment-http-test.mjs && node test/run-visual-comment-report-test.mjs && node test/run-visual-comment-fixture.mjs"
  },
  "peerDependencies": {
    "@storybook/icons": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "storybook": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/icons": "^1.4.0",
    "@storybook/react-vite": "^10.0.0",
    "@storybook/vue3-vite": "^10.0.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vue": "^3.5.0"
  },
  "storybook": {
    "displayName": "Figma Export",
    "unsupportedFrameworks": []
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  }
}
